NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SERVICE_ROLE_KEY=your_service_role_key
OMNIRoute_API_KEY=your_omniroute_key
OMNIRoute_API_URL=http://127.0.0.1:20130/v1
OMNIRoute_MODEL=combofree
# Modelo usado para leitura de imagens/fotos (visão). Opcional, padrão: auto/best-vision
OMNIRoute_VISION_MODEL=auto/best-vision
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
# brapi.dev - token grátis para ações brasileiras (dashboard de Mercado). Criar em brapi.dev após login Google/GitHub.
BRAPI_TOKEN=your_brapi_token
